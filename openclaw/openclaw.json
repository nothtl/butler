{
  "$schema": "https://openclaw.ai/x/schema",
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "DEEPSEEK_API_KEY"
        },
        "api": "openai-completions",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "deepseek-chat",
            "name": "DeepSeek Chat",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "deepseek/deepseek-chat"
      },
      "models": {
        "deepseek/deepseek-chat": {
          "agentRuntime": {
            "id": "openclaw"
          }
        }
      },
      "modelPolicy": {
        "allow": [
          "deepseek/deepseek-chat"
        ]
      }
    }
  },
  "memory": {
    "search": {
      "enabled": false
    }
  },
  "mcp": {
    "servers": {
      "butler": {
        "transport": "stdio",
        "command": "/home/tingli/butler/.venv/bin/python",
        "args": [
          "-m",
          "butler.mcp_stdio"
        ],
        "cwd": "/home/tingli/butler"
      }
    }
  }
}
